{
  "name": "ai-career-learning-advisor",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "npm --prefix server test",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed",
    "docker:up": "docker compose up --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
